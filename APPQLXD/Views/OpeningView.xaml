<UserControl x:Class="APPQLXD.Views.OpeningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Lưu bảng" Style="{StaticResource Primary}" Click="SaveClick"/>
                <Button DockPanel.Dock="Right" Content="Thêm lô" Style="{StaticResource Ghost}" Click="AddClick"/>
                <Button DockPanel.Dock="Right" Content="Xóa dòng" Style="{StaticResource Danger}" Click="RemoveClick"/>
                <TextBlock Text="Tồn đầu kỳ" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Mỗi dòng là một lô: mặt hàng, đơn giá và loại lô. Nhóm nhiên liệu và loại lô hiện như NXT tổng (ô tiêu đề có tổng tồn / thành tiền). Bấm Thêm lô để nhập tính chất rồi ghi số lượng theo kho. Không nhân VCF."/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Ngày ghi sổ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                <DatePicker SelectedDate="{Binding DocumentDate}" Width="160"/>
                <TextBlock Text="Tổng thành tiền toàn bộ" VerticalAlignment="Center" Margin="24,0,8,0" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding GrandTotalAmountText}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
        <ui:SafeDataGrid x:Name="Sheet" Grid.Row="1" ItemsSource="{Binding SheetRows}" SelectedItem="{Binding Selected}"
                  IsReadOnly="False" CanUserAddRows="False" CanUserSortColumns="False" FrozenColumnCount="5" AutoGenerateColumns="False"
                  CanUserResizeRows="False" RowHeight="36"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  LoadingRow="OnLoadingRow" BeginningEdit="OnBeginningEdit"/>
    </Grid>
</UserControl>
