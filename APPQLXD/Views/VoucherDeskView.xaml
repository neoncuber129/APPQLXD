<UserControl x:Class="APPQLXD.Views.VoucherDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:vm="clr-namespace:APPQLXD.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:APPQLXD.Views">
    <UserControl.Resources>
        <Style x:Key="Paper" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaperCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BoxCombo" TargetType="ComboBox" BasedOn="{StaticResource PaperCombo}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1B2836"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1B2836"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="#E8EEF4"/>
            <Setter Property="Foreground" Value="#1B2836"/>
            <Setter Property="BorderBrush" Value="#8AA0B5"/>
        </Style>
        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="#F8E7C4"/>
            <Setter Property="Foreground" Value="#7A4E00"/>
            <Setter Property="BorderBrush" Value="#C9860A"/>
        </Style>
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#1F7A4D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Cell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1B2836"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style x:Key="FlatPick" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2">
                                            <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#1B2836"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#1B2836" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head" TargetType="Border" BasedOn="{StaticResource Cell}">
            <Setter Property="Background" Value="#F7F1E4"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="QtyBox" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Qty}"/>
        </Style>
        <Style x:Key="FactorBox" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Factor}"/>
        </Style>
        <Style x:Key="DecimalBox" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Decimal}"/>
        </Style>
        <Style x:Key="MoneyBox" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Money}"/>
        </Style>
        <Style x:Key="PriceBox" TargetType="TextBox" BasedOn="{StaticResource Paper}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Money}"/>
        </Style>
        <DataTemplate x:Key="SlipForm">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8" Visibility="{Binding ExportDesk, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Điều chuyển kho" Command="{Binding ChooseExportModeCommand}" CommandParameter="Transfer">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransferMode}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Xuất xăng dầu lẻ" Command="{Binding ChooseExportModeCommand}" CommandParameter="Retail">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRetailMode}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Đổi loại lô" Command="{Binding ChooseExportModeCommand}" CommandParameter="LotConvert">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLotConvertMode}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Xuất máy / phương tiện" Visibility="Collapsed" Command="{Binding ChooseExportModeCommand}" CommandParameter="Consumer">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConsumerMode}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding ModeHint}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTransferMode, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Kho nhận" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ui:SafeComboBox Width="280" ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidDestination}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding TransferDetailsEnabled}">
                        <TextBlock Text="Quãng đường" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}" Visibility="{Binding ShowVehicleCalc, Converter={StaticResource BoolVis}}"/>
                        <TextBox Width="100" Style="{StaticResource Box}" ui:NumericFormat.Kind="{x:Static vm:NumericKind.Decimal}" Text="{Binding Kilometers, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowVehicleCalc, Converter={StaticResource BoolVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowManualQuantityToggle, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Nhập tay" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                            <ToggleButton Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding ManualQuantity}"
                                          ToolTip="Bật: nhập thực xuất thủ công. Tắt: tính từ km × định mức."/>
                        </StackPanel>
                        <TextBlock Text="Định mức" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}" Visibility="{Binding ShowVehicleCalc, Converter={StaticResource BoolVis}}"/>
                        <TextBox Width="100" Style="{StaticResource Box}" ui:NumericFormat.Kind="{x:Static vm:NumericKind.Factor}" Text="{Binding NormText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowVehicleCalc, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsConsumerMode, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Đối tượng" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ui:SafeComboBox Width="280" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Name">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidTarget}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                    <TextBlock Text="Định mức" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}" Visibility="{Binding IsVehicleMode, Converter={StaticResource BoolVis}}"/>
                    <TextBox Width="100" Style="{StaticResource Box}" ui:NumericFormat.Kind="{x:Static vm:NumericKind.Factor}" Text="{Binding NormText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsVehicleMode, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="Quãng đường" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}" Visibility="{Binding IsVehicleMode, Converter={StaticResource BoolVis}}"/>
                    <TextBox Width="100" Style="{StaticResource Box}" ui:NumericFormat.Kind="{x:Static vm:NumericKind.Decimal}" Text="{Binding Kilometers, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsVehicleMode, Converter={StaticResource BoolVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowManualQuantityToggle, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Nhập tay" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding ManualQuantity}"
                                      ToolTip="Bật: nhập thực xuất thủ công. Tắt: tính từ km × định mức."/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Form đơn giản: đổi loại lô -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding IsLotConvertMode, Converter={StaticResource BoolVis}}">
                <Button DockPanel.Dock="Left" Content="Quay lại danh sách" Style="{StaticResource BackButton}" Command="{Binding CloseFormCommand}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Tiếp tục thêm phiếu" IsChecked="{Binding ContinueAfterSave}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="Sau khi lưu giữ giao diện để tạo phiếu khác"/>
                    <Button Content="Lưu" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="2" BorderBrush="#1B2836" BorderThickness="1" Background="White" Padding="24" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="{Binding IsLotConvertMode, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Đổi loại lô" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Chỉ đổi nhãn TX ↔ SSCĐ trong cùng kho." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource Banner}" Margin="0,0,0,12"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                    <TextBlock Text="Kho" Style="{StaticResource Label}"/>
                    <ui:SafeComboBox Width="320" HorizontalAlignment="Left" ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidWarehouse}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                    <TextBlock Text="Ngày đổi" Style="{StaticResource Label}"/>
                    <DatePicker Width="180" HorizontalAlignment="Left" SelectedDate="{Binding DocumentDate}" SelectedDateFormat="Short"/>
                    <TextBlock Text="Lô nguồn" Style="{StaticResource Label}"/>
                    <ui:SafeComboBox Width="420" HorizontalAlignment="Left" ItemsSource="{Binding ConvertSourceLots}"
                                     SelectedItem="{Binding ConvertSourceLot}" DisplayMemberPath="Display">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidConvertSourceLot}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                    <TextBlock Text="Loại đích" Style="{StaticResource Label}"/>
                    <ui:SafeComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding ConvertLotTypeChoices}"
                                     SelectedItem="{Binding ConvertTargetLotType}" DisplayMemberPath="Code">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidConvertTargetLotType}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                    <TextBlock Text="Số lượng" Style="{StaticResource Label}"/>
                    <TextBox Width="160" HorizontalAlignment="Left"
                             Text="{Binding ConvertQuantity, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Box}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidConvertQuantity}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="Ghi chú" Style="{StaticResource Label}"/>
                    <TextBox Width="420" MinHeight="64" HorizontalAlignment="Left" Style="{StaticResource Box}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!-- Form phiếu xuất/nhập đầy đủ -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding IsLotConvertMode, Converter={StaticResource BoolVisInverse}}">
                <Button DockPanel.Dock="Left" Content="Quay lại danh sách" Style="{StaticResource BackButton}" Command="{Binding CloseFormCommand}"/>
                <Button DockPanel.Dock="Left" Content="Xóa trắng" Style="{StaticResource ResetButton}" Command="{Binding ResetSlipCommand}"
                        IsEnabled="{Binding TransferDetailsEnabled}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding TransferDetailsEnabled}">
                    <CheckBox Content="Tiếp tục thêm phiếu" IsChecked="{Binding ContinueAfterSave}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="Sau khi lưu giữ giao diện để tạo phiếu khác"/>
                    <Button Content="Lưu phiếu" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,12,0,0"
                            IsEnabled="{Binding TransferDetailsEnabled}">
                    <TextBlock Text="{Binding WarehouseLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ui:SafeComboBox Width="260" ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}">
                        <ui:SafeComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvalidWarehouse}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SafeComboBox.Style>
                    </ui:SafeComboBox>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          IsEnabled="{Binding TransferDetailsEnabled}"
                          Visibility="{Binding IsLotConvertMode, Converter={StaticResource BoolVisInverse}}">
                <Border BorderBrush="#1B2836" BorderThickness="1" Background="White" Padding="16" MinWidth="1180">
                    <StackPanel>
                        <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                        <Grid Margin="0,0,0,10">
                            <Grid Visibility="{Binding IsExport, Converter={StaticResource BoolVisInverse}}">
                                <TextBlock Text="{Binding FormTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock Text="Số" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="15"/>
                                    <TextBox Width="200" MinHeight="34" FontSize="15" VerticalContentAlignment="Center"
                                             Text="{Binding FormNumber, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource Box}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InvalidFormNumber}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding FormTitle}" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Visibility="{Binding IsExport, Converter={StaticResource BoolVis}}"/>
                        </Grid>

                        <Grid MinHeight="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="2.1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Visibility="{Binding IsExport, Converter={StaticResource BoolVisInverse}}">
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Đơn vị nhận hàng:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource PaperCombo}" BorderThickness="1" BorderBrush="#1B2836" Background="White" ItemsSource="{Binding ReceiverUnitOptions}" Text="{Binding ReceiverUnit, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Đơn vị giao hàng:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource PaperCombo}" BorderThickness="1" BorderBrush="#1B2836" Background="White" ItemsSource="{Binding SenderOptions}" Text="{Binding SenderUnit, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Tính chất nhập:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource PaperCombo}" BorderThickness="1" BorderBrush="#1B2836" Background="White" ItemsSource="{Binding NatureOptions}" Text="{Binding Nature, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Theo hợp đồng số:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding ContractOptions}" Text="{Binding ContractOrOrder, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Đơn vị vận chuyển:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding CarrierOptions}" Text="{Binding CarrierUnit, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Người giao hàng:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource PaperCombo}" BorderThickness="1" BorderBrush="#1B2836" Background="White" ItemsSource="{Binding DelivererOptions}" Text="{Binding DelivererName, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1">
                                    <TextBlock Width="158" Text="Người nhận:" VerticalAlignment="Center"/>
                                    <ui:SafeComboBox ItemsSource="{Binding ReceiverPersonOptions}" Text="{Binding ReceiverPerson, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:SafeComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource PaperCombo}">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#1B2836"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InvalidReceiverPerson}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SafeComboBox.Style>
                                    </ui:SafeComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="158" Text="Giấy giới thiệu và CMT:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding IntroOptions}" Text="{Binding IntroDocument, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Visibility="{Binding IsExport, Converter={StaticResource BoolVis}}">
                                <DockPanel Margin="0,1"><TextBlock Width="160" Text="Đơn vị giao:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SenderOptions}" Text="{Binding SenderUnit, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                                <DockPanel Margin="0,1"><TextBlock Width="160" Text="Đơn vị nhận:" VerticalAlignment="Center"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding ReceiverUnitOptions}" Text="{Binding ReceiverUnit, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
