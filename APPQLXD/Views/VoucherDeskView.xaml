                                   Visibility="{Binding IsExport, Converter={StaticResource BoolVisInverse}}"
                                   Text="Phiếu nhập: gõ thành tiền. Nếu thành tiền không chia hết cho thực nhập, chọn một cặp tách. Tổng thực nhập và tổng thành tiền hai lô phải đúng bằng số đã nhập — không tính ngược tổng từ đơn giá."/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LineCountText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding QuantityText}" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="Thành tiền:"/>
                            <Run Text="{Binding AmountWords, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Ghi chú:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding NoteOptions}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <UniformGrid Columns="6" Margin="0,16,0,0" Visibility="{Binding IsExport, Converter={StaticResource BoolVisInverse}}">
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI GIAO" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignDelivererOptions}" Text="{Binding SignerDeliverer, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI NHẬN" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignReceiverOptions}" Text="{Binding SignerReceiver, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="TÀI CHÍNH" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignFinanceOptions}" Text="{Binding SignerFinance, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI VIẾT PHIẾU" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignWriterOptions}" Text="{Binding SignerWriter, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="TRƯỞNG BAN HC-KT" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignChiefOptions}" Text="{Binding SignerChief, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="CHỈ HUY ĐƠN VỊ" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignCommanderOptions}" Text="{Binding SignerCommander, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="6" Margin="0,16,0,0" Visibility="{Binding IsExport, Converter={StaticResource BoolVis}}">
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI NHẬN" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignReceiverOptions}" Text="{Binding SignerReceiver, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI GIAO" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignDelivererOptions}" Text="{Binding SignerDeliverer, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="TÀI CHÍNH" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignFinanceOptions}" Text="{Binding SignerFinance, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="NGƯỜI VIẾT PHIẾU" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignWriterOptions}" Text="{Binding SignerWriter, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="TRƯỞNG BAN HC-KT" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignChiefOptions}" Text="{Binding SignerChief, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="CHỈ HUY ĐƠN VỊ" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/><ui:SafeComboBox Style="{StaticResource BoxCombo}" ItemsSource="{Binding SignCommanderOptions}" Text="{Binding SignerCommander, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/></StackPanel>
                        </UniformGrid>
                        <Expander Header="{Binding ExtraHeader}" Margin="0,12,0,0" IsExpanded="{Binding ExtraFieldsOpen}"
                                  Visibility="{Binding Fields.PanelVisible, Converter={StaticResource BoolVis}}">
                            <views:DynamicFieldsView DataContext="{Binding Fields}"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{Binding CreateText}" Style="{StaticResource Primary}" Command="{Binding CreateCommand}"/>
                <Button DockPanel.Dock="Right" Content="Xuất Word" Style="{StaticResource Ghost}" Command="{Binding ExportWordCommand}"/>
                <Button DockPanel.Dock="Right" Content="Xóa phiếu" Style="{StaticResource Danger}" Command="{Binding DeleteSelectedCommand}"/>
                <Button DockPanel.Dock="Right" Content="Sửa phiếu" Style="{StaticResource Ghost}" Command="{Binding EditSelectedCommand}"/>
                <Button DockPanel.Dock="Right" Content="Xem phiếu" Style="{StaticResource Ghost}" Command="{Binding ViewSelectedCommand}"/>
                <Button DockPanel.Dock="Right" Content="Bỏ chọn" Style="{StaticResource Ghost}" Command="{Binding ClearDocumentSelectionCommand}"/>
                <Button DockPanel.Dock="Right" Content="Chọn tất cả" Style="{StaticResource Ghost}" Command="{Binding SelectAllDocumentsCommand}"/>
                <StackPanel>
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding ListHint}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                        <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding ListYear, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Quý" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Muted}"/>
                        <ui:SafeComboBox Width="120" ItemsSource="{Binding ListQuarters}" SelectedItem="{Binding ListQuarter}"/>
                    </StackPanel>
                    <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </DockPanel>
            <ui:SafeDataGrid Grid.Row="1" EnableRowVirtualization="True" EnableColumnVirtualization="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding ImportDocuments}" SelectedItem="{Binding SelectedImport}"
                      Visibility="{Binding ExportDesk, Converter={StaticResource BoolVisInverse}}">
                <ui:SafeDataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditSelectedCommand}"/>
                </ui:SafeDataGrid.InputBindings>
                <ui:SafeDataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="" Width="16"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding Row.DisplayNumber}" Width="130"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Row.DocumentDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Row.Nature}" Width="220"/>
                    <DataGridTextColumn Header="Kho" Binding="{Binding Row.WarehouseName}" Width="180"/>
                    <DataGridTextColumn Header="Loại lô" Binding="{Binding Row.LotTypeCode}" Width="72"/>
                    <DataGridTextColumn Header="Người nhận" Binding="{Binding Row.ReceiverPerson}" Width="150"/>
                    <DataGridTextColumn Header="Hàng" Binding="{Binding Row.ItemName}" Width="*"/>
                    <DataGridTextColumn Header="Thực nhập" Binding="{Binding Row.ActualQuantity, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding Row.Amount, StringFormat=N0}" Width="130"/>
                </ui:SafeDataGrid.Columns>
            </ui:SafeDataGrid>
            <ui:SafeDataGrid Grid.Row="1" EnableRowVirtualization="True" EnableColumnVirtualization="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding ExportDocuments}" SelectedItem="{Binding SelectedExport}"
                      Visibility="{Binding ExportDesk, Converter={StaticResource BoolVis}}">
                <ui:SafeDataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditSelectedCommand}"/>
                </ui:SafeDataGrid.InputBindings>
                <ui:SafeDataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding Row.DisplayNumber}" Width="130"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding Row.KindName}" Width="140"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding Row.DocumentDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Row.Nature}" Width="180"/>
                    <DataGridTextColumn Header="Kho nhận" Binding="{Binding Row.DestinationWarehouseName}" Width="160"/>
                    <DataGridTextColumn Header="Loại lô" Binding="{Binding Row.LotTypeCode}" Width="72"/>
                    <DataGridTextColumn Header="Người nhận" Binding="{Binding Row.ReceiverPerson}" Width="140"/>
                    <DataGridTextColumn Header="Số xe" Binding="{Binding Row.VehiclePlate}" Width="100"/>
                    <DataGridTextColumn Header="Km" Binding="{Binding Row.Kilometers}" Width="70"/>
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Row.Mission}" Width="160"/>
                    <DataGridTextColumn Header="Hàng" Binding="{Binding Row.ItemName}" Width="*"/>
                    <DataGridTextColumn Header="Thực xuất" Binding="{Binding Row.ActualQuantity, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding Row.Amount, StringFormat=N0}" Width="130"/>
                </ui:SafeDataGrid.Columns>
            </ui:SafeDataGrid>
        </Grid>

        <ContentControl x:Name="FormHost" Focusable="False" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolVis}}"/>
    </Grid>
</UserControl>
