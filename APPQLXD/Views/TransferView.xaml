<UserControl x:Class="APPQLXD.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:APPQLXD.Views">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Điều chuyển kho" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Trừ thực xuất ở kho nguồn và cộng đúng lượng đó ở kho nhận. Không đủ tồn thì không cho xuất. Không tính là tiêu thụ."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Ngày" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding DocumentDate}"/>
                <TextBlock Text="Kho nguồn" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Source}"/>
                <TextBlock Text="Kho nhận" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Destination}"/>
                <TextBlock Text="Nơi đi" Style="{StaticResource Label}"/><TextBox Text="{Binding OriginPlace, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Nơi đến" Style="{StaticResource Label}"/><TextBox Text="{Binding DestinationPlace, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Visibility="{Binding ShowVehicleCalc, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Định mức" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding NormText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Quãng đường" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericDecimalBox}" Text="{Binding Kilometers, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <TextBlock Text="Lô" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Lots}" SelectedItem="{Binding Lot}" DisplayMemberPath="Display"/>
                <TextBlock Text="Thực xuất" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericQtyBox}" Text="{Binding Actual, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="VCF" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Vcf, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding Display, StringFormat=Giá trị xuất: {0}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Chọn phương tiện ở kho nguồn/nhận để tính thực xuất = quãng đường × định mức."/>
                <views:DynamicFieldsView DataContext="{Binding Fields}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                    <Button Content="Làm mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                    <Button Content="Sửa dòng chọn" Style="{StaticResource Ghost}" Command="{Binding EditSelectedCommand}"/>
                    <Button Content="Hủy phiếu" Style="{StaticResource Danger}" Command="{Binding VoidSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ui:SafeDataGrid Grid.Column="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding Selected}">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Nguồn" Binding="{Binding WarehouseName}" Width="140"/>
                <DataGridTextColumn Header="Nhận" Binding="{Binding DestinationWarehouseName}" Width="140"/>
                <DataGridTextColumn Header="Mặt hàng" Binding="{Binding ItemName}" Width="*"/>
                <DataGridTextColumn Header="Thực xuất" Binding="{Binding ActualQuantity, StringFormat=N0}" Width="110"/>
                <DataGridTextColumn Header="Giá trị xuất" Binding="{Binding InputQuantity, StringFormat=N0}" Width="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusName}" Width="100"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
    </Grid>
</UserControl>
