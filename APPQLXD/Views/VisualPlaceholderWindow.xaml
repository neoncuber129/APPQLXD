<Window x:Class="APPQLXD.Views.VisualPlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Placeholder template Word"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="360" MinWidth="480">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#1F7A4D" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right" Content="Đóng" Style="{StaticResource Ghost}" IsCancel="True"
                    Padding="14,6" Click="CloseClick"/>
            <Button DockPanel.Dock="Right" Content="Copy tất cả mã" Style="{StaticResource Ghost}"
                    Margin="0,0,8,0" Padding="14,6" Click="CopyAllClick"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Bấm dòng để copy mã $… vào clipboard, rồi dán vào file Word trong thư mục templateword."/>
        </StackPanel>
        <DataGrid x:Name="ListGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  Cursor="Hand" PreviewMouseLeftButtonUp="ListGridPreviewMouseLeftButtonUp">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Token}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E4D7B"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="ToolTip" Value="Bấm để copy mã này"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Dòng bảng" Binding="{Binding RowLabel}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
