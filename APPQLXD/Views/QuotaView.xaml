<UserControl x:Class="APPQLXD.Views.QuotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="QuotaCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="QuotaHead" TargetType="Border">
            <Setter Property="Background" Value="#E8EEF4"/>
            <Setter Property="BorderBrush" Value="#1B2836"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="QuotaData" TargetType="Border">
            <Setter Property="BorderBrush" Value="#1B2836"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding PageHint}"/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding Year, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="Quý" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ui:SafeComboBox Width="100" ItemsSource="{Binding Quarters}" SelectedItem="{Binding Quarter}"/>
                    <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="Bảng" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}"/>
                    <Button Content="TX + SSCĐ" Command="{Binding ShowTxSscdViewCommand}" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTxSscdView}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="IUU" Command="{Binding ShowIuuViewCommand}" Cursor="Hand" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIuuView}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Xuất Excel" Style="{StaticResource Ghost}" Margin="16,0,0,0" Padding="12,6"
                            Command="{Binding ExportExcelCommand}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SheetHost" Orientation="Vertical" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
