<UserControl x:Class="APPQLXD.Views.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Kho" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Kho XD và Kho PTKT-VTXD. Phiếu mẫu xuất gắn qua nút Phiếu mẫu."/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <TextBlock Text="Mã" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Tên kho" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Loại kho" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
            <TextBlock Text="Mẫu mặc định phiếu xuất" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding ExportSamples}" SelectedItem="{Binding ExportSample}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </StackPanel>
        <ui:SafeDataGrid Grid.Column="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TypeName}" Width="120"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
    </Grid>
</UserControl>
