<UserControl x:Class="APPQLXD.Views.FieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Trường dữ liệu" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Đang hiện các trường trên đầu phiếu nhập và phiếu xuất. Bỏ chọn để xem cột số liệu và trường tự thêm. Số phiếu và ngày không quản lý ở đây."/>
            <CheckBox Margin="0,0,0,8" Content="Chỉ trường trên phiếu" IsChecked="{Binding PaperOnly}"/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <TextBlock Text="Loại phiếu" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}"/>
            <TextBlock Text="Tên trường" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Kiểu dữ liệu" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}"/>
            <TextBlock Text="Thứ tự" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericQtyBox}" Text="{Binding Sort, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Margin="0,12,0,0" Content="Bắt buộc" IsChecked="{Binding IsRequired}"/>
            <CheckBox Margin="0,8,0,0" Content="Hiển thị" IsChecked="{Binding IsVisible}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </StackPanel>
        <ui:SafeDataGrid Grid.Column="1" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding Selected}">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Phiếu" Binding="{Binding FamilyName}" Width="120"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Kiểu" Binding="{Binding DataTypeName}" Width="100"/>
                <DataGridCheckBoxColumn Header="Bắt buộc" Binding="{Binding IsRequired}" Width="90"/>
                <DataGridCheckBoxColumn Header="Hiện" Binding="{Binding IsVisible}" Width="70"/>
                <DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder}" Width="80"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
    </Grid>
</UserControl>
