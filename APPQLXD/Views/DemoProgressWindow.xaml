<Window x:Class="APPQLXD.Views.DemoProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đang tạo dữ liệu thử" Height="240" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" Closing="OnClosing">
    <StackPanel Margin="20">
        <TextBlock x:Name="PhaseText" Text="Đang chuẩn bị..." FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ProgressBar x:Name="PhaseBar" Height="18" Margin="0,10,0,4" Minimum="0" Maximum="1"/>
        <TextBlock x:Name="PhaseCount" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <TextBlock Text="Toàn bộ" Foreground="{StaticResource Muted}"/>
        <ProgressBar x:Name="TotalBar" Height="18" Margin="0,6,0,4" Minimum="0" Maximum="1"/>
        <TextBlock x:Name="TotalCount" Foreground="{StaticResource Muted}"/>
    </StackPanel>
</Window>
