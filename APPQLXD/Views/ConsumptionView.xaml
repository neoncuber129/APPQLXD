<UserControl x:Class="APPQLXD.Views.ConsumptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <TabControl Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}">
            <TabItem Header="Nhập liệu">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tiêu thụ quý" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Mỗi năm có đủ 4 quý. Bấm Mở để vào bảng tiêu thụ (kể cả quý trống). Chỉ nhập tiêu thụ tại đây, 1 lần/quý. Điều chuyển chỉ chuyển tồn, không thay tiêu thụ quý."/>
                        <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                            <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding DraftYear, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:SafeDataGrid Grid.Row="1" ItemsSource="{Binding Quarters}" SelectedItem="{Binding SelectedQuarter}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MouseDoubleClick="OpenQuarterClick">
                        <ui:SafeDataGrid.Columns>
                            <DataGridTextColumn Header="Quý" Binding="{Binding Label}" Width="140"/>
                            <DataGridTextColumn Header="Ngày cuối quý" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="140"/>
                            <DataGridTextColumn Header="Số phiếu" Binding="{Binding Slips}" Width="100"/>
                            <DataGridTextColumn Header="Tổng tiêu thụ" Binding="{Binding Total}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Mở" Style="{StaticResource Primary}" Padding="10,2" Margin="4,2"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.OpenQuarterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:SafeDataGrid.Columns>
                    </ui:SafeDataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Danh sách sổ tiêu thụ">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Danh sách sổ tiêu thụ" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Lọc theo năm và quý, tick chọn các sổ máy / phương tiện / tàu rồi xuất Word (một file ngắt trang, zip, hoặc từng file)."/>
                        <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Chọn tất cả" Style="{StaticResource Ghost}" Margin="0,0,8,0" Command="{Binding SelectAllBooksCommand}"/>
                                <Button Content="Bỏ chọn" Style="{StaticResource Ghost}" Margin="0,0,8,0" Command="{Binding ClearBookSelectionCommand}"/>
                                <Button Content="Xuất Word" Style="{StaticResource Primary}" Command="{Binding ExportSelectedBooksCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                                <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding BookListYear, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Quý" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Muted}"/>
                                <ui:SafeComboBox Width="120" ItemsSource="{Binding BookListQuarters}" SelectedItem="{Binding BookListQuarter}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <ui:SafeDataGrid Grid.Row="1" ItemsSource="{Binding BookListItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="False" MouseDoubleClick="OpenBookClick">
                        <ui:SafeDataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Mở sổ" Style="{StaticResource Ghost}" Padding="10,2" Margin="4,2"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.OpenBookFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:SafeDataGrid.Columns>
                    </ui:SafeDataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Visibility="{Binding IsSheetOpen, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Quay lại danh sách quý" Style="{StaticResource Ghost}" Command="{Binding BackCommand}"/>
                </DockPanel>
                <TextBlock Text="{Binding QuarterTitle}" Style="{StaticResource PageTitle}" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <Button Content="Máy" Margin="0,0,8,0" Padding="14,4"
                            Command="{Binding SelectConsumerGroupCommand}" CommandParameter="Máy">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupMachine}" Value="True">
                                        <Setter Property="Background" Value="#1E4D7B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Phương tiện" Margin="0,0,8,0" Padding="14,4"
                            Command="{Binding SelectConsumerGroupCommand}" CommandParameter="Phương tiện">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupVehicle}" Value="True">
                                        <Setter Property="Background" Value="#1E4D7B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tàu" Margin="0,0,8,0" Padding="14,4"
                            Command="{Binding SelectConsumerGroupCommand}" CommandParameter="Tàu">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupShip}" Value="True">
                                        <Setter Property="Background" Value="#1E4D7B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="Chỉ xem số đã lưu từ sổ. Nhóm nhiên liệu và loại lô (TX/SSCĐ/IUU) có dòng tổng từng cột như NXT tổng. Bấm tên đối tượng (cột) để mở sổ tiêu thụ và Lưu sổ."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="FrozenBand" Grid.Column="0" Width="360" Background="#F4F7FA"/>
                    <ScrollViewer x:Name="BandScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" IsHitTestVisible="True">
                        <StackPanel x:Name="BandRow" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            <ui:SafeDataGrid x:Name="Sheet" Grid.Row="1" Margin="0" ItemsSource="{Binding SheetRows}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" FrozenColumnCount="3" AutoGenerateColumns="False"
                      CanUserResizeRows="False" ColumnHeaderHeight="28" RowHeight="26" RowBackground="White" AlternatingRowBackground="#F7F9FB"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" LoadingRow="OnLoadingRow">
                <ui:SafeDataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E7F0FA"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F3F6F9"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B2836"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B2836"/>
                </ui:SafeDataGrid.Resources>
            </ui:SafeDataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
