<UserControl x:Class="APPQLXD.Views.OpsHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:APPQLXD.Views">
    <TabControl SelectedIndex="{Binding SelectedIndex}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="14,8"/>
            </Style>
        </TabControl.Resources>
        <TabItem Header="Sổ NXT"><views:NxtView DataContext="{Binding Nxt}"/></TabItem>
        <TabItem Header="NXT tổng"><views:NxtTotalView DataContext="{Binding NxtTotal}"/></TabItem>
        <TabItem Header="NXT từng kho"><views:NxtTotalView DataContext="{Binding NxtWarehouse}"/></TabItem>
        <TabItem Header="Hạn mức"><views:QuotaView DataContext="{Binding Quota}"/></TabItem>
    </TabControl>
</UserControl>
