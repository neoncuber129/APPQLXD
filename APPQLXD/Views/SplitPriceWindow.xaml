<Window x:Class="APPQLXD.Views.SplitPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tách đơn giá" Width="640" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF8EE">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="14"
                   Text="Thành tiền không chia hết cho thực nhập. Mỗi cặp giữ đúng tổng thực nhập và tổng thành tiền đã nhập (thành tiền từng lô = đơn giá × thực nhập). Số lượng lô 2 tăng dần."/>
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="PrevButton" Content="Trang trước" Style="{StaticResource Ghost}" Width="120" Click="PrevClick"/>
            <Button x:Name="NextButton" Content="Trang sau" Style="{StaticResource Ghost}" Width="120" Margin="8,0,0,0" Click="NextClick"/>
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Đóng" Style="{StaticResource Ghost}" Width="90" Click="CloseClick"/>
        </DockPanel>
        <TextBlock x:Name="EmptyText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#9E2A2B" Visibility="Collapsed"
                   Text="Không có cặp nào giữ đơn giá phần nguyên mà vẫn khớp thực nhập và thành tiền."/>
        <StackPanel x:Name="PageList" Margin="0,12,0,0"/>
    </DockPanel>
</Window>
