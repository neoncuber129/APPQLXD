<UserControl x:Class="APPQLXD.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,8,0" Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nhóm mặt hàng" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" DataContext="{Binding GroupEditor}">
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Lưu nhóm" Style="{StaticResource Primary}" Command="{Binding SaveGroupCommand}"/>
                        <Button Content="Thêm" Style="{StaticResource Ghost}" Command="{Binding NewGroupCommand}"/>
                        <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteGroupCommand}"/>
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding GroupEditor.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:SafeListBox ItemsSource="{Binding GroupEditor.Rows}" SelectedItem="{Binding GroupEditor.Selected}" DisplayMemberPath="Name" Height="110"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Đơn vị tính" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" DataContext="{Binding UnitEditor}">
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Lưu đơn vị" Style="{StaticResource Primary}" Command="{Binding SaveUnitCommand}"/>
                        <Button Content="Thêm" Style="{StaticResource Ghost}" Command="{Binding NewUnitCommand}"/>
                        <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteUnitCommand}"/>
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding UnitEditor.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:SafeListBox ItemsSource="{Binding UnitEditor.Rows}" SelectedItem="{Binding UnitEditor.Selected}" DisplayMemberPath="Name" Height="110"/>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Mặt hàng" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Nhóm và đơn vị tính khai báo phía trên. Đổi tên mặt hàng tạo lô mới ở các phiếu sau. Phiếu và lô đã lưu giữ tên cũ."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Nhóm" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}"/>
                <TextBlock Text="Tên / loại nhiên liệu" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Mã số" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tỉ trọng 15°C" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Density, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Đơn vị tính" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"/>
                <TextBlock Text="Thông tin chất lượng" Style="{StaticResource Label}"/><TextBox Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Nhiệt độ" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericDecimalBox}" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Dữ kiện đo lường" Style="{StaticResource Label}"/><TextBox Text="{Binding Measurement, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56"/>
                <TextBlock Text="VCF" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Vcf, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Quy tắc tính số lượng" Style="{StaticResource Label}"/><TextBox Text="{Binding Rule, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ui:SafeDataGrid Grid.Column="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Nhóm" Binding="{Binding GroupName}" Width="100"/>
                <DataGridTextColumn Header="Mã số" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Tỉ trọng" Binding="{Binding Density, StringFormat=N4}" Width="90"/>
                <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitName}" Width="80"/>
                <DataGridTextColumn Header="Chất lượng" Binding="{Binding QualityInfo}" Width="120"/>
                <DataGridTextColumn Header="Nhiệt độ" Binding="{Binding Temperature, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="VCF" Binding="{Binding Vcf, StringFormat=N6}" Width="90"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
        </Grid>
    </Grid>
</UserControl>
