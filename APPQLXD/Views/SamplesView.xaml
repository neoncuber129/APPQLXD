<UserControl x:Class="APPQLXD.Views.SamplesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FamilyButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Dữ liệu mẫu" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Chọn bộ mẫu. Mỗi ô bên phải là một trường trên phiếu. Gõ giá trị rồi bấm Thêm."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Phiếu nhập" Command="{Binding ChooseFamilyCommand}" CommandParameter="Phiếu nhập">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FamilyButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImportFamily}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Phiếu xuất" Command="{Binding ChooseFamilyCommand}" CommandParameter="Phiếu xuất">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FamilyButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportFamily}" Value="True">
                                        <Setter Property="Background" Value="#0E1C2F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Text="Tên bộ mẫu" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Lưu bộ" Style="{StaticResource Primary}" Command="{Binding SaveSetCommand}"/>
                    <Button Content="Bộ mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteSetCommand}"/>
                </StackPanel>
            </StackPanel>
            <ui:SafeListBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" BorderBrush="{StaticResource Line}" Margin="0,8,0,0">
                <ui:SafeListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FamilyName}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ui:SafeListBox.ItemTemplate>
            </ui:SafeListBox>
        </DockPanel>

        <Grid Grid.Column="1">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"
                       Text="Chọn một bộ mẫu bên trái, hoặc bấm Bộ mới rồi lưu."
                       Visibility="{Binding HasSet, Converter={StaticResource BoolVisInverse}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSet, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Sections}" Margin="4,0,8,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsOpen}" Margin="0,0,0,10">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,4"/>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="340" Margin="0,0,12,12" Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="#F8FAFC">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                                                        <Button DockPanel.Dock="Right" Content="Thêm" Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center"
                                                                Background="#0E1C2F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.AddDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" PreviewKeyDown="DraftKeyDown"/>
                                                    </DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Chưa có giá trị." Foreground="{StaticResource Muted}" FontSize="12"
                                                               Visibility="{Binding HasValues, Converter={StaticResource BoolVisInverse}}"/>
                                                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Values}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,3">
                                                                        <Button DockPanel.Dock="Right" Content="Xóa" Margin="8,0,0,0" Padding="8,2" Cursor="Hand"
                                                                                Foreground="#9E2A2B" Background="White" BorderBrush="{StaticResource Line}"
                                                                                Command="{Binding DataContext.RemoveValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <TextBlock Text="{Binding Value}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
