<UserControl x:Class="APPQLXD.Views.CatalogHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FinderItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EEF5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E1C2F"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#17324F"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RowTemplate">
            <DockPanel>
                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="›" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#5C6B7A"/>
                <Button x:Name="SampleButton" DockPanel.Dock="Right" Content="Phiếu mẫu" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                        VerticalAlignment="Center" Cursor="Hand" PreviewMouseLeftButtonDown="SamplePress"
                        Visibility="{Binding CanSample, Converter={StaticResource BoolVis}}"/>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubText" Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="White"/>
                    <Setter TargetName="SubText" Property="Foreground" Value="#D5DDE8"/>
                    <Setter TargetName="Chevron" Property="Foreground" Value="White"/>
                    <Setter TargetName="SampleButton" Property="Foreground" Value="White"/>
                    <Setter TargetName="SampleButton" Property="Background" Value="Transparent"/>
                    <Setter TargetName="SampleButton" Property="BorderBrush" Value="#D5DDE8"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ItemEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Đổi tên mặt hàng tạo lô mới ở các phiếu sau. Phiếu và lô đã lưu giữ tên cũ."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Nhóm" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}"/>
                <TextBlock Text="Tên / loại nhiên liệu" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Mã số" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tỉ trọng 15°C" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Density, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Đơn vị tính" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"/>
                <TextBlock Text="Thông tin chất lượng" Style="{StaticResource Label}"/><TextBox Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Nhiệt độ" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericDecimalBox}" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Dữ kiện đo lường" Style="{StaticResource Label}"/><TextBox Text="{Binding Measurement, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56"/>
                <TextBlock Text="VCF" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Vcf, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Quy tắc tính số lượng" Style="{StaticResource Label}"/><TextBox Text="{Binding Rule, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="UnitEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Tên đơn vị tính dùng cho mặt hàng."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Tên đơn vị" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LotTypeEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="TX, SSCĐ, IUU là loại mặc định. Mã dùng trên phiếu và bảng tồn."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Mã loại lô" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tên hiển thị" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveLotTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewLotTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteLotTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MissionTaskEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Nhiệm vụ con thuộc nhóm đã chọn. Dùng trên phiếu xuất máy/xe và sổ tiêu thụ."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Tên nhiệm vụ" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Margin="0,10,0,0" Content="Đang dùng" IsChecked="{Binding IsActive}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveMissionTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewMissionTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteMissionTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WarehouseEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Kho XD (máy, phương tiện, tàu) và Kho PTKT-VTXD độc lập. Phiếu mẫu xuất gắn bằng nút Phiếu mẫu."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Mã" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tên kho" Style="{StaticResource Label}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Phiếu mẫu" Margin="8,10,0,0" Padding="10,6" Cursor="Hand"
                            Command="{Binding DataContext.OpenWarehouseSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Loại kho" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteWarehouseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ConsumerEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Máy và đối tượng khác nhập thực xuất. Phương tiện: quãng đường × định mức. Tàu: mỗi dòng chọn nhóm nhiên liệu và tỷ lệ (1 vận hành → bao nhiêu lít); tiêu thụ quý hiện nhập thực xuất trực tiếp (định mức chưa dùng để tính)."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Mã" Style="{StaticResource Label}"/><TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tên" Style="{StaticResource Label}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Phiếu mẫu" Margin="8,10,0,0" Padding="10,6" Cursor="Hand"
                            Command="{Binding DataContext.OpenConsumerSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Loại" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
                <TextBlock Text="Nhóm nhiên liệu mặc định" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}"/>
                <StackPanel Visibility="{Binding IsVehicle, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Định mức nhiên liệu" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Norm, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsShip, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Loại tàu" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ShipType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hiển thị trên sổ tiêu thụ quý tàu"/>
                    <TextBlock Text="Số máy chính hoạt động" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource NumericQtyBox}" Text="{Binding MainMachineCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mặc định điền vào sổ tiêu thụ quý"/>
                    <TextBlock Text="Số máy phụ hoạt động" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource NumericQtyBox}" Text="{Binding AuxMachineCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mặc định điền vào sổ tiêu thụ quý"/>
                    <TextBlock Text="Định mức tàu (L/giờ theo bậc công suất)" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding EffectiveNormText}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding NormFactors}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Width="90" VerticalAlignment="Center" Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBox Style="{StaticResource NumericFactorBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Lít / giờ hoạt động ở bậc này"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <CheckBox Margin="0,12,0,0" Content="Cộng dồn điều chuyển vào tiêu thụ quý"
                          IsChecked="{Binding RollTransfersIntoQuarter}"
                          Visibility="{Binding ShowRollTransfers, Converter={StaticResource BoolVis}}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveConsumerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewConsumerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteConsumerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Số phiếu và ngày không quản lý ở đây. Trường mới không bắt buộc."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Loại phiếu" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family}"/>
                <TextBlock Text="Tên trường" Style="{StaticResource Label}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Kiểu dữ liệu" Style="{StaticResource Label}"/><ui:SafeComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}"/>
                <TextBlock Text="Thứ tự" Style="{StaticResource Label}"/><TextBox Style="{StaticResource NumericQtyBox}" Text="{Binding Sort, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Margin="0,12,0,0" Content="Bắt buộc" IsChecked="{Binding IsRequired}"/>
                <CheckBox Margin="0,8,0,0" Content="Hiển thị" IsChecked="{Binding IsVisible}"/>
                <WrapPanel>
                    <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SampleEditor">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Sửa nội dung từng trường ngay tại phiếu. Số phiếu và ngày không nằm ở đây."
                           Visibility="{Binding IsCatalogSlip, Converter={StaticResource BoolVis}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Gõ giá trị của từng trường rồi bấm Thêm. Số phiếu và ngày không nằm ở đây."
                           Visibility="{Binding ShowAddHint, Converter={StaticResource BoolVis}}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Tự điền nội dung, hoặc chọn một giá trị từ phiếu xuất. Bấm Lưu phiếu mẫu để ghi lại. Phiếu xuất sẽ hiện các trường này khi chọn đối tượng."
                           Visibility="{Binding IsOwnedEditor, Converter={StaticResource BoolVis}}"/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Loại phiếu" Style="{StaticResource Label}" Visibility="{Binding ShowSetTools, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Family}" FontWeight="SemiBold" Visibility="{Binding ShowSetTools, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="Tên bộ mẫu" Style="{StaticResource Label}" Visibility="{Binding ShowSetTools, Converter={StaticResource BoolVis}}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowSetTools, Converter={StaticResource BoolVis}}"/>
                <WrapPanel Visibility="{Binding ShowSetTools, Converter={StaticResource BoolVis}}">
                    <Button Content="Lưu bộ" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="Bộ mới" Style="{StaticResource Ghost}" Command="{Binding DataContext.NewSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsOwnedEditor, Converter={StaticResource BoolVisInverse}}"/>
                    <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsOwnedEditor, Converter={StaticResource BoolVisInverse}}"/>
                </WrapPanel>
                <TextBlock Margin="0,16,0,0" Foreground="{StaticResource Muted}" Text="Lưu bộ mẫu trước khi thêm giá trị."
                           Visibility="{Binding HasSet, Converter={StaticResource BoolVisInverse}}"/>
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsOwnedEditor, Converter={StaticResource BoolVis}}">
                    <Button Content="Lưu phiếu mẫu" Style="{StaticResource Primary}" Command="{Binding SaveOwnedCommand}"/>
                    <Button Content="Điền ô trống từ phiếu xuất" Style="{StaticResource Ghost}" Command="{Binding FillFromExportCommand}"/>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding OwnedFields}" Margin="0,12,0,0" Visibility="{Binding IsOwnedEditor, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="340" Margin="0,0,12,12">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,8"
                                           Visibility="{Binding HasHeader, Converter={StaticResource BoolVis}}"/>
                                <Border Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="#F8FAFC">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBox Margin="0,8,0,0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Margin="0,8,0,4" FontSize="12" Foreground="{StaticResource Muted}" Text="Chọn từ phiếu xuất"
                                                   Visibility="{Binding HasChoices, Converter={StaticResource BoolVis}}"/>
                                        <ui:SafeComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Picked}"
                                                         Visibility="{Binding HasChoices, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,12,0,0" Visibility="{Binding ShowValueLists, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsOpen}" Margin="0,0,0,10">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,4"/>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="340" Margin="0,0,12,12" Padding="12" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="#F8FAFC">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                                                        <Button DockPanel.Dock="Right" Content="Thêm" Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center"
                                                                Background="#0E1C2F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding Content.AddDraftCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" PreviewKeyDown="DraftKeyDown"/>
                                                    </DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="Chưa có giá trị." Foreground="{StaticResource Muted}" FontSize="12"
                                                               Visibility="{Binding HasValues, Converter={StaticResource BoolVisInverse}}"/>
                                                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Values}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,3">
                                                                        <Button DockPanel.Dock="Right" Content="Xóa" Margin="8,0,0,0" Padding="8,2" Cursor="Hand"
                                                                                Foreground="#9E2A2B" Background="White" BorderBrush="{StaticResource Line}"
                                                                                Command="{Binding Content.RemoveValueCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                                                CommandParameter="{Binding}"/>
                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="12,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,8">
            <TextBlock Text="Danh mục" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" Text="Các nhóm xếp từ trái sang phải. Bấm một dòng để mở cột bên cạnh."/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <Grid x:Name="BrowserHost" Grid.Row="1">
            <ScrollViewer x:Name="Browser" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#F3F5F8">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ActualHeight (DP) — ViewportHeight không notify nên cột dễ bị Height=0 và ẩn hết -->
                            <Border Width="{Binding Width}" Height="{Binding ActualHeight, ElementName=BrowserHost}" Background="White"
                                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="#F7F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Margin="14,8,14,8" Visibility="{Binding ShowExtraToggle, Converter={StaticResource BoolVis}}">
                                        <CheckBox Content="Hiện trường bổ sung trên phiếu" IsChecked="{Binding DataContext.Fields.ShowExtraOnSlip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                                   Text="Tắt thì phiếu nhập và phiếu xuất không hiện mục trường bổ sung."/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="14,8,14,0" Visibility="{Binding ShowPaperFilter, Converter={StaticResource BoolVis}}">
                                        <CheckBox Content="Chỉ trường trên phiếu" Click="PaperClick"
                                                  IsChecked="{Binding DataContext.Fields.PaperOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="12" Visibility="{Binding ShowGroupFooter, Converter={StaticResource BoolVis}}">
                                        <StackPanel Visibility="{Binding GroupFooterOn, Converter={StaticResource BoolVis}}">
                                            <Border Style="{StaticResource Banner}" DataContext="{Binding DataContext.Items.GroupEditor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="Tên nhóm" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBox Margin="0,4,0,0" Text="{Binding DataContext.Items.GroupEditor.Name, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                                            <WrapPanel>
                                                <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Content="Thêm nhóm" Style="{StaticResource Ghost}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.NewGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="12" Visibility="{Binding ShowMissionGroupFooter, Converter={StaticResource BoolVis}}">
                                        <StackPanel Visibility="{Binding MissionGroupFooterOn, Converter={StaticResource BoolVis}}">
                                            <Border Style="{StaticResource Banner}" DataContext="{Binding DataContext.Missions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="Mã nhóm" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBox Margin="0,4,0,0" Text="{Binding DataContext.Missions.GroupCode, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Margin="0,6,0,0" Text="Tên nhóm" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            <TextBox Margin="0,4,0,0" Text="{Binding DataContext.Missions.GroupName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Margin="0,8,0,0"
                                                      Content="Nhóm hao hụt"
                                                      IsChecked="{Binding DataContext.Missions.GroupIsLoss, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      ToolTip="Bật: nhóm nằm dưới dòng Cộng tiêu thụ trên bảng hạn mức (không cộng vào tiêu thụ I–IV)."/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                       Text="Hao hụt tách khỏi phần tiêu thụ phía trên; vẫn vào Tổng cộng."/>
                                            <WrapPanel>
                                                <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding DataContext.SaveMissionGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DataContext.DeleteMissionGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Content="Thêm nhóm" Style="{StaticResource Ghost}" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.NewMissionGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                    <Grid>
                                        <ui:SafeListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                                                        SelectionChanged="EntrySelected" BorderThickness="0" Background="Transparent"
                                                        HorizontalContentAlignment="Stretch"
                                                        ItemContainerStyle="{StaticResource FinderItem}"
                                                        ItemTemplate="{StaticResource RowTemplate}"
                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                        VirtualizingPanel.IsVirtualizing="False"
                                                        Visibility="{Binding IsList, Converter={StaticResource BoolVis}}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,8,16,16"
                                                      Visibility="{Binding IsEditor, Converter={StaticResource BoolVis}}">
                                        <ContentControl Content="{Binding Editor}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="item">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ItemEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="unit">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource UnitEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="lottype">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource LotTypeEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="missiontask">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource MissionTaskEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="warehouse">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource WarehouseEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="consumer">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ConsumerEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="field">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource FieldEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="sample">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource SampleEditor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
