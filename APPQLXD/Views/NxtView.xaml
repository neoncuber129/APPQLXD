<UserControl x:Class="APPQLXD.Views.NxtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding PageHint}"/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding Year, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="Quý" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Muted}"/>
                <ui:SafeComboBox Width="100" ItemsSource="{Binding Quarters}" SelectedItem="{Binding Quarter}"/>
                <Button Content="Xuất Word" Style="{StaticResource Ghost}" Margin="16,0,8,0" Padding="12,6" Command="{Binding ExportWordCommand}"/>
                <Button Content="Xuất Excel" Style="{StaticResource Ghost}" Margin="0,0,8,0" Padding="12,6" Command="{Binding ExportExcelCommand}"/>
                <TextBlock Text="Chế độ xem" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}"/>
                <Button Content="TX + SSCĐ" Command="{Binding ShowTxSscdViewCommand}" Margin="0,12,6,0" Padding="14,8" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Setter Property="Margin" Value="0,12,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTxSscdView}" Value="True">
                                    <Setter Property="Background" Value="#0E1C2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="IUU" Command="{Binding ShowIuuViewCommand}" Margin="0,12,8,0" Padding="14,8" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Setter Property="Margin" Value="0,12,8,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIuuView}" Value="True">
                                    <Setter Property="Background" Value="#0E1C2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding ShowWarehousePicker, Converter={StaticResource BoolVis}}">
                <Button Content="Chọn kho" Style="{StaticResource Ghost}" Command="{Binding ChooseWarehousesCommand}"/>
                <TextBlock Text="{Binding WarehouseLabel}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{Binding WarehouseLabel}"
                       Visibility="{Binding ShowWarehousePicker, Converter={StaticResource BoolVisInverse}}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="HBarRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="VBarColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftHead"/>
            <ScrollViewer x:Name="HeadScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FuelHead" HorizontalAlignment="Left"/>
            </ScrollViewer>
            <ScrollViewer x:Name="LeftScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Top" PreviewMouseWheel="LeftWheel" ScrollChanged="LeftScrollChanged">
                <StackPanel x:Name="LeftBody" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
            <ScrollViewer x:Name="FuelScroll" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          VerticalContentAlignment="Top"
                          ScrollChanged="FuelScrollChanged" SizeChanged="FuelScrollChanged">
                <StackPanel x:Name="FuelBody" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
            <ScrollBar x:Name="VBar" Grid.Row="1" Grid.Column="2" Orientation="Vertical" Minimum="0" Maximum="0" ValueChanged="BarChanged"/>
            <ScrollBar x:Name="HBar" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Minimum="0" Maximum="0" ValueChanged="BarChanged"/>
            <Border x:Name="DrawOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#E6F3F5F8" Visibility="Collapsed" Panel.ZIndex="4">
                <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DrawText" Text="Đang lập sổ NXT" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar Height="16" Margin="0,12,0,0" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
