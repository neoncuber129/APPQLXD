<UserControl x:Class="APPQLXD.Views.NxtTotalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LeftCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{Binding PageHint}"/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Năm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                <TextBox Width="80" VerticalContentAlignment="Center" Text="{Binding Year, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="Quý" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Muted}"/>
                <ui:SafeComboBox Width="100" ItemsSource="{Binding Quarters}" SelectedItem="{Binding Quarter}"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PerWarehouse}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Kho" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}"/>
                    <ui:SafeComboBox Width="260"
                                     ItemsSource="{Binding Warehouses}"
                                     SelectedItem="{Binding SelectedWarehouse}"
                                     DisplayMemberPath="Name"/>
                </StackPanel>
                <Button Content="Xuất Word" Style="{StaticResource Ghost}" Margin="16,0,8,0" Padding="12,6" Command="{Binding ExportWordCommand}"/>
                <Button Content="Xuất Excel" Style="{StaticResource Ghost}" Margin="0,0,8,0" Padding="12,6" Command="{Binding ExportExcelCommand}"/>
                <TextBlock Text="Chế độ xem" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}"/>
                <Button Content="Toàn bộ" Command="{Binding ShowAllViewCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Setter Property="Margin" Value="0,12,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllView}" Value="True">
                                    <Setter Property="Background" Value="#0E1C2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="TX + SSCĐ" Command="{Binding ShowTxSscdViewCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Setter Property="Margin" Value="0,12,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTxSscdView}" Value="True">
                                    <Setter Property="Background" Value="#0E1C2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="IUU" Command="{Binding ShowIuuViewCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Setter Property="Margin" Value="0,12,8,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIuuView}" Value="True">
                                    <Setter Property="Background" Value="#0E1C2F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="{Binding WarehouseLabel}"/>
        </StackPanel>
        <ui:SafeDataGrid x:Name="Sheet" Grid.Row="1" ItemsSource="{Binding Rows}"
                         IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                         AutoGenerateColumns="False" CanUserResizeRows="False" RowHeight="32"
                         LoadingRow="OnLoadingRow"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Lô" Binding="{Binding LotText}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource LeftCell}"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceText}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Loại lô" Binding="{Binding LotTypeText}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Tồn đầu" Binding="{Binding Opening, StringFormat=N0}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Nhập" Binding="{Binding In, StringFormat=N0}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Xuất" Binding="{Binding Out, StringFormat=N0}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Tồn sau" Binding="{Binding Closing, StringFormat=N0}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterCell}"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*" MinWidth="120" ElementStyle="{StaticResource LeftCell}"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
    </Grid>
</UserControl>
