<UserControl x:Class="APPQLXD.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Nhóm mặt hàng" Style="{StaticResource PageTitle}"/>
            <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
            <TextBlock Text="Tên nhóm" Style="{StaticResource Label}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Lưu" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                <Button Content="Thêm mới" Style="{StaticResource Ghost}" Command="{Binding NewCommand}"/>
                <Button Content="Xóa" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </StackPanel>
        <ui:SafeDataGrid Grid.Column="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ui:SafeDataGrid.Columns>
                <DataGridTextColumn Header="Tên nhóm" Binding="{Binding Name}" Width="*"/>
            </ui:SafeDataGrid.Columns>
        </ui:SafeDataGrid>
    </Grid>
</UserControl>
