<UserControl x:Class="APPQLXD.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:APPQLXD.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Lịch sử chứng từ" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Chi tiết bên phải là snapshot lúc lưu. Đổi danh mục không làm thay đổi phiếu này."/>
                <Border Style="{StaticResource Banner}"><TextBlock Text="{Binding Banner}" TextWrapping="Wrap"/></Border>
                <TextBlock Text="Loại chứng từ" Style="{StaticResource Label}"/>
                <ui:SafeComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"/>
            </StackPanel>
            <ui:SafeDataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <ui:SafeDataGrid.Columns>
                    <DataGridTextColumn Header="Số" Binding="{Binding Number}" Width="100"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding KindName}" Width="130"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" Width="120"/>
                    <DataGridTextColumn Header="Mặt hàng" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="Thực tế" Binding="{Binding ActualQuantity, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="VCF" Binding="{Binding Vcf, StringFormat=N6}" Width="80"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusName}" Width="90"/>
                </ui:SafeDataGrid.Columns>
            </ui:SafeDataGrid>
        </DockPanel>
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Background="{StaticResource AppBg}">
                <Button Content="Sửa phiếu" Style="{StaticResource Primary}" Command="{Binding EditSelectedCommand}"/>
                <Button Content="Hủy phiếu" Style="{StaticResource Danger}" Command="{Binding VoidSelectedCommand}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}">
            <StackPanel DataContext="{Binding Detail}">
                <TextBlock Text="{Binding Number}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Slip.FormNumber}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Slip.Nature}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Slip.Kilometers}"/>
                <TextBlock Text="{Binding Slip.Mission}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Slip.AmountInWords}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusName}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Mặt hàng snapshot" Style="{StaticResource Label}"/><TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GroupName}"/><TextBlock Text="{Binding UnitName}"/>
                <TextBlock Text="{Binding QualityInfo}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,8,0,0" Text="{Binding ConversionRule}" TextWrapping="Wrap"/>
                <TextBlock Text="VCF đã dùng" Style="{StaticResource Label}"/><TextBlock Text="{Binding Vcf, StringFormat=N6}"/>
                <TextBlock Text="Kho" Style="{StaticResource Label}"/><TextBlock Text="{Binding WarehouseName}"/>
                <TextBlock Text="Kho nhận" Style="{StaticResource Label}"/><TextBlock Text="{Binding DestinationWarehouseName}"/>
                <TextBlock Text="Đối tượng" Style="{StaticResource Label}"/><TextBlock Text="{Binding ConsumerName}"/>
                <TextBlock Text="{Binding ConsumerTypeName}"/>
                <TextBlock Text="Định mức / quãng đường" Style="{StaticResource Label}"/>
                <TextBlock Text="{Binding Norm, StringFormat=N6}"/>
                <TextBlock Text="{Binding Distance, StringFormat=N4}"/>
                <TextBlock Text="Số lượng / giá trị" Style="{StaticResource Label}"/><TextBlock Text="{Binding InputQuantity, StringFormat=N0}"/>
                <TextBlock Text="Thực nhập / thực xuất" Style="{StaticResource Label}"/><TextBlock Text="{Binding ActualQuantity, StringFormat=N0}"/>
                <TextBlock Text="Dòng lô" Style="{StaticResource Label}"/>
                <ui:SafeDataGrid ItemsSource="{Binding Lines}" MaxHeight="160">
                    <ui:SafeDataGrid.Columns>
                        <DataGridTextColumn Header="Hàng" Binding="{Binding ItemName}" Width="100"/>
                        <DataGridTextColumn Header="VCF" Binding="{Binding Vcf, StringFormat=N4}" Width="60"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Thực tế" Binding="{Binding ActualQuantity, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Tiền" Binding="{Binding Amount, StringFormat=N0}" Width="*"/>
                    </ui:SafeDataGrid.Columns>
                </ui:SafeDataGrid>
                <TextBlock Text="Trường snapshot" Style="{StaticResource Label}"/>
                <ui:SafeDataGrid ItemsSource="{Binding Fields}" MaxHeight="160">
                    <ui:SafeDataGrid.Columns>
                        <DataGridTextColumn Header="Trường" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" Width="*"/>
                    </ui:SafeDataGrid.Columns>
                </ui:SafeDataGrid>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
