<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:APPQLXD.Controls"
                    xmlns:vm="clr-namespace:APPQLXD.ViewModels">
    <SolidColorBrush x:Key="AppBg" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="Ink" Color="#1B2836"/>
    <SolidColorBrush x:Key="Muted" Color="#5C6B7A"/>
    <SolidColorBrush x:Key="Line" Color="#D9E0E8"/>
    <SolidColorBrush x:Key="Accent" Color="#C9860A"/>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <!-- Ô số: định dạng Việt Nam theo thời gian thực -->
    <Style x:Key="NumericQtyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Qty}"/>
    </Style>
    <Style x:Key="NumericMoneyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Money}"/>
    </Style>
    <Style x:Key="NumericDecimalBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Decimal}"/>
    </Style>
    <Style x:Key="NumericFactorBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:NumericFormat.Kind" Value="{x:Static vm:NumericKind.Factor}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="32"/>
        <!-- Style (không phải Default) để DatePicker lấy vi-VN thay vì CurrentCulture hệ thống -->
        <Setter Property="Language" Value="vi-VN"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,4"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Background" Value="#0E1C2F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,12,8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,12,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="#9E2A2B"/>
    </Style>
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="#E5F4EC"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Banner}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                <Setter Property="Background" Value="#FDECEC"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F6F8FB"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
    </Style>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#D5DDE8"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#17324F"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút gạt bật/tắt: tắt xám, bật cam. -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#CBD5E1" SnapsToDevicePixels="True">
                        <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                                HorizontalAlignment="Left" Margin="3,3,0,3" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#C9860A"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
