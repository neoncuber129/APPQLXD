<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APPQLXD.Core\APPQLXD.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- templateword được tạo lúc chạy (SampleTemplateBuilder); giữ thư mục nếu đã chỉnh tay -->
  <ItemGroup>
    <None Include="templateword\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('templateword')" />
  </ItemGroup>

</Project>
